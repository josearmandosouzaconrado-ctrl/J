{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.soldado_romano.postura": {
      "initial_state": "normal",
      "states": {
        "normal": {
          "animations": [
            "parado",
            {
              "andar": "query.modified_move_speed > 0.05"
            }
          ],
          "transitions": [
            {
              "combate": "query.property('romano:em_combate')"
            },
            {
              "construindo": "query.property('romano:construindo') && !query.property('romano:em_combate')"
            },
            {
              "guarda": "query.property('romano:de_guarda') && !query.property('romano:em_combate')"
            },
            {
              "acao_comer": "query.property('romano:acao') == 1"
            },
            {
              "acao_tomar_sopa": "query.property('romano:acao') == 2"
            },
            {
              "acao_beber": "query.property('romano:acao') == 3"
            },
            {
              "acao_dormir": "query.property('romano:acao') == 4"
            },
            {
              "acao_conversar": "query.property('romano:acao') == 5"
            }
          ],
          "blend_transition": 0.2
        },
        "acao_comer": {
          "animations": [
            "comer"
          ],
          "transitions": [
            {
              "normal": "query.property('romano:acao') != 1"
            }
          ],
          "blend_transition": 0.3
        },
        "acao_tomar_sopa": {
          "animations": [
            "tomar_sopa"
          ],
          "transitions": [
            {
              "normal": "query.property('romano:acao') != 2"
            }
          ],
          "blend_transition": 0.3
        },
        "acao_beber": {
          "animations": [
            "beber"
          ],
          "transitions": [
            {
              "normal": "query.property('romano:acao') != 3"
            }
          ],
          "blend_transition": 0.3
        },
        "acao_dormir": {
          "animations": [
            "dormir"
          ],
          "transitions": [
            {
              "normal": "query.property('romano:acao') != 4"
            }
          ],
          "blend_transition": 0.3
        },
        "acao_conversar": {
          "animations": [
            "conversar"
          ],
          "transitions": [
            {
              "normal": "query.property('romano:acao') != 5"
            }
          ],
          "blend_transition": 0.3
        },
        "guarda": {
          "animations": [
            "parado",
            {
              "andar": "query.property('romano:marchando')"
            }
          ],
          "transitions": [
            {
              "combate": "query.property('romano:em_combate')"
            },
            {
              "normal": "!query.property('romano:de_guarda')"
            }
          ],
          "blend_transition": 0.2
        },
        "construindo": {
          "animations": [
            "construir"
          ],
          "transitions": [
            {
              "combate": "query.property('romano:em_combate')"
            },
            {
              "normal": "!query.property('romano:construindo')"
            }
          ],
          "blend_transition": 0.2
        },
        "combate": {
          "animations": [
            "combate",
            {
              "andar": "query.modified_move_speed > 0.05"
            }
          ],
          "transitions": [
            {
              "normal": "!query.property('romano:em_combate')"
            }
          ],
          "blend_transition": 0.25
        }
      }
    },
    "controller.animation.soldado_romano.ataque": {
      "initial_state": "pronto",
      "states": {
        "pronto": {
          "transitions": [
            {
              "atacando": "variable.attack_time > 0"
            }
          ]
        },
        "atacando": {
          "animations": [
            "atacar"
          ],
          "transitions": [
            {
              "pronto": "query.all_animations_finished"
            }
          ]
        }
      }
    }
  }
}