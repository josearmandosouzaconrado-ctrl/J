{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.sherman.andar": {
      "initial_state": "parado",
      "states": {
        "parado": {
          "transitions": [
            {
              "andando": "query.ground_speed > 0.3"
            }
          ],
          "blend_transition": 0.3
        },
        "andando": {
          "animations": [
            "andar"
          ],
          "transitions": [
            {
              "parado": "query.ground_speed <= 0.3"
            }
          ],
          "blend_transition": 0.3
        }
      }
    },
    "controller.animation.sherman.tiro": {
      "initial_state": "pronto",
      "states": {
        "pronto": {
          "transitions": [
            {
              "tiro": "query.property('sherman:atirando')"
            }
          ]
        },
        "tiro": {
          "animations": [
            "atirar"
          ],
          "transitions": [
            {
              "pronto": "!query.property('sherman:atirando')"
            }
          ]
        }
      }
    }
  }
}