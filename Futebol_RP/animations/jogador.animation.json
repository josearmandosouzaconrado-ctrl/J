{
  "format_version": "1.8.0",
  "animations": {
    "animation.fut_jogador.olhar": {
      "loop": true,
      "bones": {
        "head": { "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0] }
      }
    },
    "animation.fut_jogador.correr": {
      "loop": true,
      "bones": {
        "body": { "rotation": [6, 0, 0] },
        "rightLeg": { "rotation": ["math.sin(query.life_time * 900) * 55", 0, 0] },
        "leftLeg": { "rotation": ["-math.sin(query.life_time * 900) * 55", 0, 0] },
        "rightArm": { "rotation": ["-math.sin(query.life_time * 900) * 45", 0, 0] },
        "leftArm": { "rotation": ["math.sin(query.life_time * 900) * 45", 0, 0] }
      }
    },
    "animation.fut_jogador.chutar": {
      "loop": true,
      "bones": {
        "rightLeg": { "rotation": [-70, 0, 0] },
        "leftArm": { "rotation": [-30, 0, -20] },
        "rightArm": { "rotation": [20, 0, 25] },
        "body": { "rotation": [-8, 0, 0] }
      }
    },
    "animation.fut_jogador.comemorar": {
      "loop": true,
      "bones": {
        "root": { "position": [0, "math.abs(math.sin(query.life_time * 400)) * 4", 0] },
        "rightArm": { "rotation": [0, 0, "160 + math.sin(query.life_time * 800) * 15"] },
        "leftArm": { "rotation": [0, 0, "-160 - math.sin(query.life_time * 800) * 15"] }
      }
    }
  }
}
